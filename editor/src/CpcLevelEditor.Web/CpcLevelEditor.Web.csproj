<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- ASP.NET Core is in the shared framework. The ONE package is Google's
       OAuth handler, which is not: the alternative is hand-rolling an OAuth 2
       exchange, and a credential path written by hand is the last place to
       save a dependency. Everything else - the cookie, the antiforgery, the
       SMTP client - is already in the box. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CpcLevelEditor.Application\CpcLevelEditor.Application.csproj" />
  </ItemGroup>
</Project>
