@{
    Layout = null;
}
@*
    The painter. A VIEW and not a static file: wwwroot/ is served before
    authorization runs, so as index.html this page came up for anybody and
    then failed every API call it made - which reads as a broken editor and
    not as a closed one. See HomeController.
*@
<!doctype html>
<meta charset="utf-8">
<title>Kara Loft — level editor</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="~/editor.css">

<header>
  <strong>Kara Loft</strong>
  <select id="projects" title="open a project"></select>
  <button id="open-shipped" title="open the level the game already plays">Open the City</button>
  <span class="spacer"></span>
  <label>zoom <input id="zoom" type="range" min="1" max="4" step="1" value="2"></label>
  <button id="save">Save</button>
  <button id="generate" title="fill this project in with a level that can be played">Generate</button>
  <button id="validate">Validate</button>
  <button id="export">Export</button>
  <span id="whoami" class="who"></span>
</header>

<main>
  <aside>
    <!-- ANY LEVEL OF THE PACKAGE, not only the City. The six directories
         and their tile sheets come from /api/assets, which reads the art
         the artist shipped; a new project starts empty and its tile flags
         start empty with it, because there is no file anywhere that says
         what a tile DOES (CLAUDE.md 11 step 7). -->
    <details id="new-project">
      <summary>new project</summary>
      <label>level <select id="new-level"></select></label>
      <label>sheet <select id="new-sheet"></select></label>
      @* THE SHAPE, and the list is the ENGINE's - /api/vocabulary builds
         it out of EngineLimits, the same way every other list on this
         page comes off an enum rather than being spelled out here. *@
      <label>shape <select id="new-shape"></select></label>
      <label>id <input id="new-id" placeholder="level2-draft"></label>
      <button id="new-make">Create</button>
    </details>
    <div class="tools" id="tools">
      <button data-tool="brush" class="on">Brush</button>
      <button data-tool="rect">Rect</button>
      <button data-tool="fill">Fill</button>
      <button data-tool="pick">Pick</button>
      <button data-tool="overlay">Overlay +</button>
      <button data-tool="overlay-clear">Overlay −</button>
      <button data-tool="entity">Entity</button>
      <button data-tool="region">Region</button>
    </div>
    <div class="layers">
      <label><input type="checkbox" id="show-grid" checked> grid</label>
      <label><input type="checkbox" id="show-screen" checked> screen</label>
      <label><input type="checkbox" id="show-overlays" checked> overlays</label>
      <label><input type="checkbox" id="show-entities" checked> entities</label>
      <label><input type="checkbox" id="show-regions" checked> regions</label>
      <label><input type="checkbox" id="show-solid"> solid</label>
    </div>
    <div id="palette" class="palette"></div>
    <div id="tile-detail" class="detail"></div>
    <div id="inspector" class="detail"></div>
  </aside>

  <section class="stage">
    <div class="canvas-wrap"><canvas id="map"></canvas></div>
    <pre id="report"></pre>
  </section>
</main>

<footer id="status">no project open</footer>
<script type="module" src="~/editor.js"></script>
